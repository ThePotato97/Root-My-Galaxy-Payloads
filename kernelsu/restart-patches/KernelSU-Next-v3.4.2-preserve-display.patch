+#[cfg(test)]
+mod tests {
+    use super::planned_boot_count;
+
+    #[test]
+    fn planned_restart_refunds_one_start_without_erasing_failure_history() {
+        assert_eq!(planned_boot_count("1").unwrap().as_deref(), Some("0"));
+        assert_eq!(planned_boot_count("4").unwrap().as_deref(), Some("3"));
+    }
+
+    #[test]
+    fn zero_and_missing_counter_are_handled_without_creating_an_alias() {
+        assert_eq!(planned_boot_count("0").unwrap().as_deref(), Some("0"));
+        assert_eq!(planned_boot_count("").unwrap(), None);
+    }
+
+    #[test]
+    fn invalid_counter_aborts_before_any_restart() {
+        assert!(planned_boot_count("-1").is_err());
+        assert!(planned_boot_count("unknown").is_err());
+        assert!(planned_boot_count("4294967296").is_err());
+    }
+}
